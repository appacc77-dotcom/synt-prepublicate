---
/**
 * Секция `method-hero` (323:423), 1440×800: фото на всю секцию, заголовок и
 * описание слева внизу.
 *
 * Раскладка из спеки:
 *   method-hero   — 1440×800, заливка FILL (cover, центр)
 *   hero-content  — 64, 470, 600×266, VERTICAL
 *   hero-title    — 600×64, Literata 64/64, цвет text-on-image
 *   hero-desc     — 0, 96, 600×170, Golos 20/34, цвет text-on-image
 */
interface Props {
  node?: string;
}

const { node = '323:423' } = Astro.props;
---

<section class="mhero" data-figma-node={node}>
  <div class="mhero__content" data-figma-node="323:862">
    <h1 class="mhero__title" data-figma-node="323:863">Метод Syntonia</h1>
    <p class="mhero__desc" data-figma-node="323:864">
      Syntonia — это глубинный метод работы с человеком как с целостной системой. Он объединяет науку,
      психологическую точность и тонкое видение внутренней природы, чтобы помогать возвращать себе подлинное
      состояние и жизненную силу.
    </p>
  </div>
</section>

<style>
  .mhero {
    position: relative;
    width: 100%;
    height: 800px;
    background-image: url('/img/method-hero.webp');
    background-size: cover;
    background-position: 50% 50%;
    background-repeat: no-repeat;
  }

  .mhero__content {
    position: absolute;
    left: 64px;
    top: 470px;
    display: flex;
    flex-direction: column;
    width: 600px;
    height: 266px;
  }

  .mhero__title {
    width: 600px;
    height: 64px;
    margin: 0;
    font-family: var(--font-literata);
    font-weight: 300;
    font-size: 64px;
    line-height: 64px;
    letter-spacing: 0;
    color: var(--color-text-on-image);
  }

  .mhero__desc {
    width: 600px;
    height: 170px;
    margin: 32px 0 0;
    font-size: 20px;
    line-height: 34px;
    color: var(--color-text-on-image);
  }
</style>
