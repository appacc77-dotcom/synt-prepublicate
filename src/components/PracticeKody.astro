---

<section class="pkody" data-figma-node={node}>
  <div class="pkody__container" data-figma-node="414:1971">
    <div class="pkody__head" data-figma-node="414:1972">
      <h2 class="pkody__title" data-figma-node="414:1973">Коды состояний</h2>
      <p class="pkody__subtitle" data-figma-node="414:1974">
        Для более глубокой самостоятельной работы с тем состоянием, которое сильнее всего влияет на жизнь сейчас.
      </p>
    </div>

    <div class="pkody__grid">
      {rows.map((row, rowIndex) => (
        <div class="pkody__row" data-figma-node={row.node} style={`height: ${row.height}px`}>
          {cards.slice(rowIndex * 2, rowIndex * 2 + 2).map((card) => <PracticePayCard card={card} />)}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const section = document.querySelector('.pkody');
  if (section) {
    for (const button of section.querySelectorAll('[data-play]')) {
      button.addEventListener('click', () => {
        const playing = button.getAttribute('aria-pressed') === 'true';
        button.setAttribute('aria-pressed', String(!playing));
        button.classList.toggle('is-playing', !playing);
      });
    }
    for (const button of section.querySelectorAll('.pay__buy')) {
      button.addEventListener('click', () => {
        const note = document.getElementById(button.getAttribute('aria-describedby'));
        if (note) note.hidden = !note.hidden;
      });
    }
  }
</script>

<style>
  .pkody {
    position: relative;
    width: 100%;
    height: 2078px;
    background: var(--color-practice-surface);
  }

  .pkody__container {
    box-sizing: border-box;
    width: 1280px;
    height: 2078px;
    margin: 0 auto;
    padding-top: 96px;
  }

  .pkody__head {
    box-sizing: border-box;
    width: 1280px;
    height: 176px;
    padding-top: 16px;
  }

  .pkody__title {
    width: 588px;
    height: 94px;
    margin: 0 0 0 346px;
    font-family: var(--font-literata);
    font-size: 75px;
    line-height: 93.75px;
    font-weight: 400;
    color: var(--color-text-primary);
  }

  .pkody__subtitle {
    width: 1114px;
    height: 34px;
    margin: 16px 0 0 83px;
    font-size: 20px;
    line-height: 34px;
    color: var(--color-text-primary);
  }

  .pkody__grid {
    width: 1280px;
    margin-top: 64px;
  }

  .pkody__row {
    display: flex;
    gap: 32px;
    width: 1280px;
  }

  .pkody__row + .pkody__row {
    margin-top: 64px;
  }
</style>
