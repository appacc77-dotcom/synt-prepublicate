---
/**
 * Секция `library-issues` (272:1044), 1440×555: заголовок и четыре карточки
 * выпусков журнала.
 *
 * Карточка 296×347: обложка 296×236 (фото CROP + градиент сверху) и тело
 * 296×95 с номером, названием, описанием и кнопкой.
 */
import { backgroundOf } from '../lib/fill.mjs';
import ArrowQuiet from './ds/arrow-quiet.astro';

interface Props {
  node?: string;
}

const { node = '272:1044' } = Astro.props;

const cards = [
  {
    id: '281:665',
    image: '/img/issue-3aa9.webp',
    crop: [[0.6839599013328552, 0, 0.14034323394298553], [0, 0.9770305156707764, 0.010927828960120678]],
    num: '№02',
    title: 'Тело и состояние',
    desc: 'Как внутреннее состояние управляет нашими решениями — и что делать, когда выбор даётся с трудом.',
    action: 'открыть выпуск',
    soon: false,
  },
  {
    id: '281:709',
    image: '/img/issue-659c.jpg',
    crop: [[0.6839599013328552, 0, 0.14034323394298553], [0, 0.9770305156707764, 0.010927828960120678]],
    num: '№01',
    title: 'Внутренняя опора',
    desc: 'О том, как найти устойчивость внутри, когда снаружи всё меняется. Состояния, практики и способ слышать себя.',
    action: 'открыть выпуск',
    soon: false,
  },
  {
    id: '281:723',
    image: '/img/issue-9fe6.jpg',
    crop: [[0.6839599013328552, 0, -0.00011277136945864186], [0, 0.9770305156707764, 0.010927828960120678]],
    num: '№00',
    title: 'Вступительное слово',
    desc: 'Что собой представляют выпуски журнала Syntonia.Life, и как сделать чтение максимально удобным и эффективным.',
    action: 'открыть выпуск',
    soon: false,
  },
  {
    id: '281:737',
    image: '/img/issue-affc.jpg',
    crop: [[0.6839599013328552, 0, 0.14034323394298553], [0, 0.9770305156707764, 0.010927828960120678]],
    num: '№03',
    title: 'СКОРО',
    desc: 'Превью для будущего выпуска',
    action: 'СКОРО',
    soon: true,
  },
];
---

<section class="liss" data-figma-node={node}>
  <div class="liss__container" data-figma-node="457:2321">
    <div class="liss__heading" data-figma-node="272:1070">
      <h2 class="liss__title" data-figma-node="272:1050">Все выпуски</h2>
      <a class="liss__all" href="/library.html" data-figma-node="272:1064">
        <span class="liss__all-label" data-figma-node="I272:1064;16:50">смотреть все</span>
        <ArrowQuiet size={19} />
      </a>
    </div>

    <div class="liss__list" data-figma-node="272:1071">
      {cards.map((card) => (
        <article class="jcard" data-figma-node={card.id}>
          <div
            class="jcard__cover"
            style={`background: ${backgroundOf({ url: card.image, scaleMode: 'CROP', imageTransform: card.crop })}, linear-gradient(180deg, rgb(0 0 0 / 0%) 40%, rgb(0 0 0 / 35%) 100%)`}
          >
            <span class="jcard__num">{card.num}</span>
            <span class="jcard__title">{card.title}</span>
          </div>
          <div class="jcard__body">
            <p class="jcard__desc">{card.desc}</p>
            {card.soon ? (
              <span class="jcard__soon">{card.action}</span>
            ) : (
              <a class="jcard__btn" href="/book.html">
                <span>{card.action}</span>
                <ArrowQuiet size={14} />
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .liss {
    position: relative;
    width: 100%;
    height: 555px;
    background: var(--color-bg-page);
    box-sizing: border-box;
    /* Отступ секции — padding: margin первого блока схлопывается. */
    padding-top: 64px;
  }

  .liss__container {
    box-sizing: border-box;
    width: 1280px;
    height: 427px;
    margin: 0 auto;
  }

  .liss__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    width: 1280px;
    height: 48px;
  }

  .liss__title {
    width: 1117px;
    height: 48px;
    margin: 0;
    font-family: var(--font-literata);
    font-size: 38px;
    line-height: 47.5px;
    font-weight: 400;
    color: var(--color-text-heading);
  }

  .liss__all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: 163px;
    height: 29px;
    margin-top: 10px;
    text-decoration: none;
  }

  .liss__all-label {
    flex: none;
    width: 136px;
    font-size: 17px;
    line-height: 29px;
    letter-spacing: 0.03em;
    color: var(--color-accent);
  }

  .liss__all :global(svg) {
    display: block;
    color: var(--color-accent);
  }

  .liss__list {
    display: flex;
    gap: 32px;
    width: 1280px;
    height: 347px;
    margin-top: 32px;
  }

  .jcard {
    flex: none;
    width: 296px;
    height: 347px;
  }

  .jcard__cover {
    position: relative;
    width: 296px;
    height: 236px;
    border-radius: 12px;
    overflow: hidden;
  }

  .jcard__num {
    position: absolute;
    left: 16px;
    top: 16px;
    font-size: 16px;
    line-height: 20px;
    color: var(--color-text-on-image);
  }

  /* Название стоит на обложке, под номером — как в макете. */
  .jcard__title {
    position: absolute;
    left: 16px;
    top: 36px;
    width: 134px;
    height: 20px;
    font-size: 16px;
    line-height: 20px;
    white-space: nowrap;
    color: var(--color-text-on-image);
  }

  .jcard__body {
    width: 296px;
    height: 95px;
    margin-top: 16px;
  }

  .jcard__desc {
    width: 296px;
    height: 60px;
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-text-primary);
  }

  .jcard__btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    box-sizing: border-box;
    height: 27px;
    margin-top: 8px;
    padding: 4px 8px;
    border: 1px solid var(--color-accent);
    border-radius: 3px;
    text-decoration: none;
  }

  .jcard__btn span {
    font-size: 11px;
    line-height: 19px;
    color: var(--color-accent);
  }

  .jcard__btn :global(svg) {
    display: block;
    color: var(--color-accent);
  }

  .jcard__soon {
    display: inline-block;
    margin-top: 8px;
    font-size: 11px;
    line-height: 19px;
    letter-spacing: 0.03em;
    color: var(--color-text-secondary);
  }
</style>
