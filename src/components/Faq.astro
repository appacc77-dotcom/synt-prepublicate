const arrowDown = `<svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.98167 9.66315C8.78741 9.18476 8.01589 9.19439 7.82082 8.56929C7.6533 7.95355 7.95073 7.76378 7.69599 7.12614C7.58366 6.82522 7.56035 6.49584 7.56724 6.20411C7.57392 5.84605 7.62986 5.56844 7.56888 5.39141C7.46321 5.05533 7.89427 5.08856 7.89124 4.66082C7.89877 4.22662 8.04088 3.99097 8.30463 3.71061C8.55756 3.41443 9.16369 2.54997 9.29233 2.13661C9.40359 1.70245 9.9906 1.54545 10.2935 1.50324C10.3881 1.48594 10.4748 1.49797 10.5337 1.52579C10.5584 1.53755 10.5681 1.56623 10.568 1.59394C10.568 1.59396 10.568 1.59397 10.568 1.59399C10.5674 1.6287 10.5559 1.66229 10.5353 1.66873C10.4303 1.69846 10.2964 1.83061 10.2257 2.05483C10.118 2.47035 9.89745 2.32545 9.68108 2.83685C9.48617 3.35764 9.55851 3.73062 9.19104 4.2423C8.84325 4.79135 9.40551 5.06417 8.98817 5.78657C8.92997 5.90202 8.90214 6.00536 8.89582 6.09491C8.88178 6.65023 9.40913 6.72471 9.70464 7.3125C10.026 7.99661 10.4163 9.06003 10.5924 9.03961C10.6103 9.04162 10.6074 9.0282 10.568 9.02059C10.3016 9.04604 10.4764 9.01735 10.593 8.84597C10.7273 8.68571 10.8865 8.46111 11.0576 8.22578C11.4801 7.6427 11.5866 6.69083 11.8375 5.98871C11.9045 5.80168 11.9631 5.5923 11.9932 5.40062C12.0753 4.77641 11.9381 3.99681 11.8603 3.58908C11.748 3.03155 11.6994 2.87532 11.3279 2.49045C11.1034 2.27668 10.9061 1.94794 10.6648 1.70107C10.5297 1.59692 10.5157 1.4523 10.7824 1.45407C11.1496 1.49584 11.2884 1.73804 11.5108 1.73959C11.956 1.76651 12.1592 1.83519 12.2317 2.27019C12.2897 2.69614 12.725 2.66517 12.7901 2.9007C12.837 3.14292 12.6741 3.19153 13.1958 4.25567C13.3602 4.6215 13.4669 4.96062 13.529 5.27263C13.6435 5.95126 13.5808 6.34878 13.5551 6.66295C13.512 7.14341 13.0439 7.97195 12.7911 8.65755C12.6849 8.95277 12.4854 9.35533 12.1912 9.76644C11.8668 10.1447 11.6023 10.7172 10.568 10.8445C10.2762 10.8539 10.0605 10.7975 9.90046 10.7547C8.96476 10.4047 9.23976 10.1463 8.98167 9.66315Z" fill="currentColor"/><path d="M8.90939 19.1195C8.73881 18.6629 7.9186 19.0023 7.6461 18.5116C7.36899 18.0255 7.60114 17.6739 7.11647 17.2877C6.6371 16.8962 6.39723 16.2601 6.10243 16.1686C5.81148 16.0733 6.10579 15.7321 5.7668 15.521C5.43023 15.3076 5.3101 15.0928 5.16677 14.7522C5.02602 14.409 4.35789 13.5948 3.98981 13.4262C3.62494 13.2543 3.49357 12.7682 3.34489 12.5468C3.2993 12.4771 3.2701 12.4154 3.25193 12.3639C3.24424 12.342 3.25219 12.3202 3.2668 12.3053C3.2668 12.3053 3.26681 12.3053 3.26682 12.3053C3.26682 12.3053 3.26682 12.3053 3.26682 12.3053C3.28501 12.2868 3.31357 12.2789 3.33505 12.2952C3.43937 12.3741 3.60777 12.4793 3.84318 12.5664C4.28504 12.7259 4.17283 12.9069 4.66294 13.2308C5.15413 13.5536 5.56914 13.6254 5.96946 14.1862C6.35954 14.7574 6.93945 14.3891 7.3885 15.2989C7.81739 16.2293 8.41407 15.7653 9.22316 16.3035C9.77009 16.6715 10.2211 17.3021 10.5869 17.7911C10.5307 17.7976 10.5051 17.8249 10.495 17.7997C10.4813 17.7611 10.4065 17.7115 10.3259 17.737C10.5595 17.4412 10.8284 17.1351 11.1539 16.8689C11.7946 16.3549 12.2011 15.3429 12.9828 14.8486C13.7676 14.3573 14.8835 13.6691 15.4663 13.4172C16.0475 13.1638 16.1926 13.1053 16.4688 12.5834C16.6277 12.2834 16.9946 12.0155 17.5072 11.9882C17.7653 11.9746 17.9118 12.179 17.8592 12.3961C17.7819 12.7132 17.538 12.7963 17.6483 13.1071C17.8676 13.7271 17.9335 13.9637 17.4258 13.9761C16.9213 13.9916 17.3397 14.6431 17.1199 14.7251C16.9004 14.8073 16.5947 14.5022 16.0434 15.475C15.4852 16.441 15.096 16.8889 14.8452 17.2161C14.5903 17.5392 13.723 17.8849 13.3149 18.4187C13.0697 18.7344 12.5874 19.1595 12.1793 19.5567C11.5684 20.1779 10.7279 20.3135 10.2397 20.3048C9.29663 20.2557 9.15004 19.8278 8.97344 19.4349C8.9664 19.3403 8.95127 19.2364 8.90939 19.1195Z" fill="currentColor"/></svg>`;
---

<section class="faq" id="home-faq" data-figma-node="148:508">
  <div class="faq__container" data-figma-node="148:509">
    <div class="faq__intro" data-figma-node="148:510">
      <div class="faq__heading" data-figma-node="148:511">
        <h2 class="faq__title" data-figma-node="148:512">
          <span class="faq__title-top t-h2" data-figma-node="148:513">{titleTop}</span>
          <span class="faq__title-indent" data-figma-node="148:514">
            <span class="faq__title-bottom" data-figma-node="148:515">{titleBottom}</span>
          </span>
        </h2>
        <p class="faq__lead t-body" data-figma-node="148:516">{lead}</p>
      </div>

      <BtnPrimary href={ctaHref} label={ctaLabel} node="148:517" theme="light" compact />
    </div>

    <div class="faq__list" data-figma-node="148:518">
      {
        items.map((item) => (
          <div
            class:list={['faq__item', item.state === 'open' && 'faq__item--open']}
            data-figma-node={item.nodes.item}
          >
            <button
              class="faq__head"
              type="button"
              aria-expanded={item.state === 'open' ? 'true' : 'false'}
              data-figma-node={item.nodes.head}
            >
              <h3 class="faq__question t-h4" data-figma-node={item.nodes.question}>
                {item.question}
              </h3>
              {/* В макете это две разные стрелки, а не повёрнутая одна:
                  показываем обе и переключаем прозрачностью. */}
              <span class="faq__icon" data-figma-node={item.nodes.icon}>
                <span class="faq__icon-down"><Fragment set:html={arrowDown} /></span>
                <span class="faq__icon-up"><Fragment set:html={arrowUp} /></span>
              </span>
            </button>

            {/* Ответ есть у всех вопросов: в файле он лежит в других инстансах
                секции (по одному открытому на состояние). */}
            <p class="faq__answer t-body" data-figma-node={item.nodes.answer}>
              {item.answer}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* faq (148:508): VERTICAL, gap 0, pad 128/24, MIN/CENTER. Высота в узле
     807, контент 511 — остаток 40 снизу остаётся пустым, как в макете. */
  .faq {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 807px;
    padding: var(--space-5xl) var(--space-l);
    /* Заливка — изображение 1672×941, scaleMode FILL = cover по центру.
       100% 100% растягивало фон, когда секция выше 807 (открытый аккордеон). */
    background-image: url('/img/faq-bg.webp');
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
  }

  /* container (148:509): HORIZONTAL, gap 48, MIN/MIN, max-width 1280. */
  .faq__container {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xl);
    width: 100%;
    max-width: var(--container-max);
  }

  /* faq-intro (148:510): VERTICAL, gap 64, ширина фиксирована 397. */
  .faq__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: none;
    gap: var(--space-3xl);
    width: 397px;
  }

  /* faq-heading (148:511): VERTICAL, gap 48, counter MIN. */
  .faq__heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xl);
    width: 100%;
  }

  /* faq-title (148:512): VERTICAL, gap 0, HUG по обеим осям → ширина по
     самому широкому ребёнку (faq-title-indent, 336). */
  .faq__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* faq-title-top (148:513): ширина из узла 208 — часть макета, от неё
     зависят три строки H2 (3 × 60 = 180). */
  .faq__title-top {
    width: 208px;
    color: var(--color-text-heading);
  }

  /* faq-title-indent (148:514): HORIZONTAL, gap 0, pad слева 160,
     counter CENTER. 160 в шкале нет — это 128 + 32. */
  .faq__title-indent {
    display: flex;
    align-items: center;
    padding-left: calc(var(--space-5xl) + var(--space-xl));
  }

  /* faq-title-bottom (148:515): стиля в typography.css нет (styleName: null),
     поэтому кегль и строка заданы здесь: 42 px при 125 % — строка 52,5,
     Figma округляет до 53, узел 106 = 2 × 53. */
  .faq__title-bottom {
    width: 176px;
    font-family: var(--font-literata);
    font-weight: 300;
    font-size: 42px;
    line-height: 53px;
    color: var(--color-text-heading);
  }

  /* faq-lead (148:516): FILL — на всю ширину колонки (397). */
  .faq__lead {
    width: 100%;
    color: var(--color-text-deep);
  }

  /* faq-list (148:518): VERTICAL, gap 16, ширина FILL — остаток контейнера. */
  .faq__list {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: var(--space-m);
    min-width: 0;
  }

  /* faq-item: VERTICAL, gap 24, pad 16/24, radius 12.
     Обводка INSIDE — inset-тень: рамка прибавила бы к высоте 2 px (71 → 73). */
  .faq__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding: var(--space-m) var(--space-l);
    border-radius: var(--radius-m);
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }

  /* state=open: заливка белым 55 % и без обводки. */
  .faq__item--open {
    background: var(--color-bg-glass);
    box-shadow: none;
  }

  /* faq-head: HORIZONTAL, CENTER. Gap в узле 24, но вопрос 766 + иконка 21 =
     787 — свободного места нет, фактический зазор 0; gap: 24 отнял бы у
     вопроса ровно 24 px и развёл бы его с эталоном. */
  /* Голова — кнопка: клавиатура и скринридер работают без костылей. */
  .faq__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0;
    width: 100%;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
  }

  /* Две стрелки друг на друге: открытая проявляется, закрытая гаснет. */
  .faq__icon {
    position: relative;
    display: block;
  }

  .faq__icon-down,
  .faq__icon-up {
    display: block;
    transition: opacity var(--motion-base) var(--ease-out);
  }

  .faq__icon-up {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .faq__item--open .faq__icon-up {
    opacity: 1;
  }

  .faq__item--open .faq__icon-down {
    opacity: 0;
  }

  /* Ответ есть в разметке у всех, показывается только у открытого. */
  .faq__answer {
    display: none;
  }

  .faq__item--open .faq__answer {
    display: block;
    animation: motion-fade var(--motion-base) var(--ease-out) both;
  }

  /* faq-question: H4 29/39, grow 1 → 787 − 21 = 766. */
  .faq__question {
    flex: 1 1 auto;
    min-width: 0;
    color: var(--color-text-primary);
  }

  /* faq-icon: 21 × 21, цвет — акцент (заливка вектора). */
  .faq__icon {
    flex: none;
    width: 21px;
    height: 21px;
    color: var(--color-accent);
  }

  /* faq-answer: body 20/34, ширина FILL 787 → две строки = 68. */
  .faq__answer {
    color: var(--color-text-deep);
  }

</style>

<script>
  // Аккордеон: открыт один вопрос, остальные закрываются.
  const root = document.querySelector('.faq');
  if (root) {
    const items = [...root.querySelectorAll('.faq__item')];
    items.forEach((item) => {
      const button = item.querySelector('.faq__head');
      button?.addEventListener('click', () => {
        const willOpen = !item.classList.contains('faq__item--open');
        items.forEach((other) => {
          other.classList.remove('faq__item--open');
          other.querySelector('.faq__head')?.setAttribute('aria-expanded', 'false');
        });
        if (willOpen) {
          item.classList.add('faq__item--open');
          button.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }
</script>
