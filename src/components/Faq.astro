---
/**
 * Faq — секция `faq` (148:508) страницы Home.
 *
 * Геометрия с живого узла: 1440×807, паддинг 128/24, контейнер 1280 по центру.
 * Две колонки: интро 397 фиксированной ширины и список 835 — это остаток
 * 1280 − 397 − 48.
 *
 * Раскладка из спеки:
 *   faq           — VERTICAL, gap 0, pad 128/24, MIN/CENTER, высота 807 фиксирована
 *   container     — HORIZONTAL, gap 48, MIN/MIN, max-width 1280
 *   faq-intro     — VERTICAL, gap 64, MIN/MIN, ширина 397
 *   faq-heading   — VERTICAL, gap 48, MIN/MIN
 *   faq-title     — VERTICAL, gap 0, HUG/HUG (336 = 208 против 160 + 176)
 *   faq-list      — VERTICAL, gap 16
 *   faq-item      — VERTICAL, gap 24, pad 16/24, radius 12
 *   faq-head      — HORIZONTAL, CENTER, вопрос тянется, иконка 21
 *
 * Пустой остаток снизу (807 − 128 − 511 − 128 = 40) — факт макета: у корня
 * mainSizing FIXED, контент прижат к верху.
 *
 * Состояний ровно два, оба есть в файле как варианты набора `faq-item`
 * (144:355): open — стеклянная заливка 55 % и ответ, closed — обводка 1 px
 * внутри и только вопрос. Поведение (клик, анимация) в макете не задано,
 * поэтому разметка статична.
 */
import BtnPrimary from './ds/btn-primary.astro';

interface ItemNodes {
  item: string;
  head: string;
  question: string;
  icon: string;
  answer?: string;
}

interface Item {
  /** `state` варианта набора `faq-item`. */
  state: 'open' | 'closed';
  question: string;
  answer?: string;
  nodes: ItemNodes;
}

interface Props {
  titleTop: string;
  titleBottom: string;
  lead: string;
  ctaLabel: string;
  ctaHref: string;
  items: Item[];
}

const { titleTop, titleBottom, lead, ctaLabel, ctaHref, items } = Astro.props;

/**
 * arrow-quiet accent up / down (21×21) — вектор выгружен с узлов
 * I148:519;756:1883 и I148:520;755:2882. Инлайном, а не <img>: цвет берётся
 * из токена через currentColor, и файл нечему потерять.
 */
const arrowUp = `<svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12.0183 11.3369C12.2126 11.8152 12.9841 11.8056 13.1792 12.4307C13.3467 13.0465 13.0493 13.2362 13.304 13.8739C13.4163 14.1748 13.4396 14.5042 13.4328 14.7959C13.4261 15.1539 13.3701 15.4316 13.4311 15.6086C13.5368 15.9447 13.1057 15.9114 13.1088 16.3392C13.1012 16.7734 12.9591 17.009 12.6954 17.2894C12.4424 17.5856 11.8363 18.45 11.7077 18.8634C11.5964 19.2976 11.0094 19.4546 10.7065 19.4968C10.6119 19.5141 10.5252 19.502 10.4663 19.4742C10.4416 19.4624 10.4319 19.4338 10.432 19.4061C10.432 19.406 10.432 19.406 10.432 19.406C10.4326 19.3713 10.4441 19.3377 10.4647 19.3313C10.5697 19.3015 10.7036 19.1694 10.7743 18.9452C10.882 18.5297 11.1026 18.6745 11.3189 18.1631C11.5138 17.6424 11.4415 17.2694 11.809 16.7577C12.1568 16.2087 11.5945 15.9358 12.0118 15.2134C12.07 15.098 12.0979 14.9946 12.1042 14.9051C12.1182 14.3498 11.5909 14.2753 11.2954 13.6875C10.974 13.0034 10.5837 11.94 10.4076 11.9604C10.3897 11.9584 10.3926 11.9718 10.432 11.9794C10.6984 11.954 10.5236 11.9827 10.407 12.154C10.2727 12.3143 10.1135 12.5389 9.94237 12.7742C9.51993 13.3573 9.41342 14.3092 9.16249 15.0113C9.09549 15.1983 9.03686 15.4077 9.0068 15.5994C8.9247 16.2236 9.06192 17.0032 9.13965 17.4109C9.25196 17.9685 9.30061 18.1247 9.67214 18.5095C9.89662 18.7233 10.0939 19.0521 10.3352 19.2989C10.4703 19.4031 10.4843 19.5477 10.2176 19.5459C9.85044 19.5042 9.71156 19.262 9.48922 19.2604C9.04401 19.2335 8.84082 19.1648 8.76828 18.7298C8.71031 18.3039 8.27505 18.3348 8.20994 18.0993C8.16301 17.8571 8.32589 17.8085 7.80424 16.7443C7.63976 16.3785 7.53313 16.0394 7.47099 15.7274C7.35652 15.0487 7.41922 14.6512 7.44486 14.3371C7.48796 13.8566 7.95615 13.0281 8.20889 12.3424C8.31513 12.0472 8.51464 11.6447 8.80883 11.2336C9.13315 10.8553 9.39774 10.2828 10.432 10.1555C10.7238 10.1461 10.9395 10.2025 11.0995 10.2453C12.0352 10.5953 11.7602 10.8537 12.0183 11.3369Z" fill="currentCol