---
/**
 * Library — секция `library` (148:487), фрейм `main` (79:103).
 *
 * Геометрия с живого узла: 1440×641, фон-фотография, справа текстовая колонка
 * 493 px с ярлыком, метаданными, заголовком, описанием и тихой ссылкой.
 *
 * Раскладка из спеки:
 *   library          — HORIZONTAL, gap 10, pad 96/24, CENTER/MIN
 *   container        — VERTICAL, gap 0, pad 0, MIN/MAX, maxW 1280
 *   library-content  — VERTICAL, gap 32, MIN/MIN, 493
 *   library-head     — VERTICAL, gap 4, MIN/MIN, 168
 *   meta             — HORIZONTAL, gap 8, CENTER/CENTER
 *   library-body     — VERTICAL, gap 32, MIN/MIN, 493
 *   btn-quiet        — HORIZONTAL, gap 8, CENTER/CENTER, plain/S
 *
 * Контент — пропсы с умолчаниями из спеки: так страницу можно собрать без
 * данных, а страница-композиция подставит свои.
 *
 * Вариант кнопки в макете — `style: plain, size: S`: подпись стиля `button`
 * (17/29) без подчёркивания. В ds/btn-quiet.astro собран вариант `underline/L`
 * (подпись 24 px, линия), поэтому кнопка собрана здесь по узлу 148:500,
 * а не переиспользована с чужими размерами.
 */
interface Props {
  eyebrow?: string;
  meta?: string[];
  title?: string;
  desc?: string;
  ctaLabel?: string;
  href?: string;
}

const {
  eyebrow = 'библиотека',
  meta = ['Книга', 'журналы'],
  title = 'Где для внутреннего находятся слова',
  desc = 'Книга и выпуски журнала Syntonia собраны в одном пространстве — чтобы читать медленно, возвращаться по состоянию и находить слова для того, что происходит внутри.',
  ctaLabel = 'Открыть библиотеку',
  // Библиотека теперь существует как страница /library.html.
  href = '/library.html',
} = Astro.props;

/** Узлы двух элементов метаданных. Разделитель между ними — 148:493. */
const metaNodes = ['148:492', '148:494'];
/** Ширины пунктов из узлов: браузер набирает 58.5 и 89.5 при 59 и 90. */
const metaWidths = [59, 90];
---

<section class="library" id="home-library" data-figma-node="148:487">
  <div class="library__container" data-figma-node="751:1255">
    <div class="library__content" data-figma-node="148:488">
      <div class="library__head" data-figma-node="148:489">
        <p class="library__eyebrow t-eyebrow" data-figma-node="148:490">{eyebrow}</p>

        <div class="library__meta" data-figma-node="148:491">
          {meta.map((item, index) => (
            <>
              {index > 0 && <span class="library__dot" data-figma-node="148:493" aria-hidden="true" />}
              <span
                class="library__meta-item t-body"
                style={`width:${metaWidths[index]}px`}
                data-figma-node={metaNodes[index]}
              >{item}</span>
            </>
          ))}
        </div>
      </div>

      <div class="library__body" data-figma-node="148:497">
        <h2 class="library__title t-h2" data-figma-node="148:498">{title}</h2>
        <p class="library__desc t-body" data-figma-node="148:499">{desc}</p>
      </div>

      <a class="library__btn" href={href} data-figma-node="148:500">
        <!-- Ширина подписи из узла: браузер набирает 182.5 при 183 в спеке,
             а ворота вычитают трекинг после последней буквы. -->
        <span class="library__btn-label t-button" style="width:183px" data-figma-node="I148:500;16:50">{ctaLabel}</span>
        <span class="library__arrow" data-figma-node="I148:500;16:62">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 20 19" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10.1087 10.7963C9.679 10.9708 9.68766 11.6639 9.12611 11.8391C8.57298 11.9896 8.40251 11.7224 7.8297 11.9512C7.55938 12.0522 7.26349 12.0731 7.00142 12.0669C6.67978 12.0609 6.4304 12.0106 6.27136 12.0654C5.96946 12.1603 5.99931 11.7731 5.61506 11.7758C5.22501 11.7691 5.01332 11.6414 4.76147 11.4045C4.4954 11.1773 3.71885 10.6328 3.34751 10.5172C2.9575 10.4173 2.81647 9.88995 2.77855 9.61783C2.76301 9.53291 2.77381 9.45494 2.7988 9.4021C2.80937 9.37985 2.83513 9.37121 2.86002 9.37131C2.86004 9.37131 2.86006 9.37131 2.86007 9.37131C2.89125 9.37176 2.92142 9.38215 2.92721 9.40063C2.95392 9.495 3.07263 9.61526 3.27405 9.67878C3.64732 9.77549 3.51716 9.97363 3.97655 10.168C4.44439 10.3431 4.77945 10.2781 5.23909 10.6082C5.73232 10.9206 5.9774 10.4156 6.62634 10.7905C6.73005 10.8427 6.82289 10.8677 6.90333 10.8734C7.40219 10.886 7.46909 10.4123 7.99711 10.1468C8.61166 9.8582 9.56695 9.50754 9.5486 9.34936C9.55042 9.33328 9.53836 9.33587 9.53152 9.37131C9.55438 9.61056 9.52861 9.45353 9.37466 9.34881C9.23069 9.22818 9.02893 9.08511 8.81753 8.93142C8.29374 8.55194 7.43865 8.45625 6.80793 8.23084C6.63992 8.17065 6.45183 8.11798 6.27963 8.09098C5.71889 8.01722 5.01857 8.14049 4.65229 8.21033C4.15145 8.31121 4.01111 8.35491 3.66538 8.68866C3.47335 8.89032 3.17803 9.06754 2.95626 9.28428C2.8627 9.40565 2.73279 9.41829 2.73438 9.17865C2.7719 8.84883 2.98947 8.72408 2.99086 8.52435C3.01505 8.12441 3.07675 7.94188 3.46751 7.87671C3.85015 7.82464 3.82234 7.43363 4.03392 7.37514C4.2515 7.33299 4.29517 7.4793 5.25111 7.0107C5.57974 6.86295 5.88438 6.76716 6.16466 6.71133C6.77429 6.6085 7.13139 6.66483 7.41361 6.68786C7.84522 6.72658 8.58951 7.14716 9.2054 7.3742C9.4706 7.46964 9.83223 7.64886 10.2015 7.91314C10.5414 8.20448 11.0556 8.44217 11.17 9.37131C11.1784 9.63338 11.1278 9.82718 11.0893 9.97093C10.7749 10.8115 10.5428 10.5644 10.1087 10.7963Z" fill="currentColor"/>
          <path d="M18.604 10.8611C18.1938 11.0144 18.4987 11.7512 18.0579 11.996C17.6212 12.2449 17.3054 12.0363 16.9585 12.4717C16.6067 12.9024 16.0353 13.1178 15.9532 13.3827C15.8675 13.644 15.561 13.3796 15.3714 13.6842C15.1797 13.9865 14.9867 14.0944 14.6808 14.2232C14.3725 14.3496 13.641 14.9498 13.4896 15.2805C13.3352 15.6082 12.8985 15.7263 12.6996 15.8598C12.637 15.9008 12.5816 15.927 12.5353 15.9433C12.5157 15.9502 12.4961 15.9431 12.4827 15.93C12.4827 15.93 12.4827 15.93 12.4827 15.93C12.4827 15.93 12.4827 15.9299 12.4827 15.9299C12.4827 15.9299 12.4827 15.9299 12.4827 15.9299C12.466 15.9136 12.459 15.8879 12.4736 15.8687C12.5445 15.7749 12.639 15.6237 12.7173 15.4122C12.8605 15.0153 13.0231 15.1161 13.3141 14.6758C13.604 14.2345 13.6685 13.8617 14.1723 13.5021C14.6855 13.1517 14.3546 12.6308 15.1719 12.2274C16.0077 11.8421 15.5908 11.3061 16.0743 10.5793C16.4049 10.0879 16.9713 9.68274 17.4106 9.35422C17.4165 9.40468 17.441 9.42762 17.4184 9.43674C17.3837 9.44905 17.3391 9.51625 17.362 9.58864C17.0964 9.37876 16.8214 9.13728 16.5823 8.84481C16.1205 8.26925 15.2114 7.90412 14.7674 7.20189C14.326 6.49694 13.7078 5.4945 13.4815 4.97096C13.2539 4.44879 13.2013 4.31852 12.7325 4.07032C12.463 3.92759 12.2223 3.59802 12.1978 3.13751C12.1856 2.90568 12.3692 2.77405 12.5642 2.82132C12.8491 2.89077 12.9237 3.10991 13.2029 3.01081C13.7599 2.81375 13.9725 2.75459 13.9836 3.21068C13.9975 3.66383 14.5827 3.28798 14.6564 3.48542C14.7303 3.6826 14.4562 3.95728 15.3301 4.45254C16.1979 4.95399 16.6002 5.30361 16.8941 5.5289C17.1844 5.75789 17.495 6.53694 17.9744 6.90358C18.2581 7.12383 18.64 7.55713 18.9967 7.9237C19.5548 8.47249 19.6766 9.22753 19.6688 9.66605C19.6247 10.5133 19.2402 10.6449 18.8873 10.8036C18.8023 10.8099 18.709 10.8235 18.604 10.8611Z" fill="currentColor"/>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  /* library (148:487): заливка — IMAGE scaleMode FILL, снятая с узла. В кропе
     фотография лежит как cover по центру: 1672×941 при 1440×641 дают
     1440×810.4 со сдвигом −84.7 px по y; подгонка по кропу — средняя 2.26.
     Формула спеки для FILL (m00×100 % × m11×100 % = 100 % × 66.88 %) дала бы
     полосу высотой 428.7 px и среднюю 49.5 — это не то, что нарисовала Figma:
     imageTransform [[1, 0, −6.4e−6], [0, 0.6688, −2.2e−4]] cover не описывает. */
  .library {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: var(--space-4xl) var(--space-l);
    background-image: url('/img/library-bg.webp');
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
  }

  /* container (751:1255): ширина FILL с потолком 1280, высота по содержимому;
     counter MAX — колонка прижата к правому краю. */
  .library__container {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    width: 100%;
    max-width: var(--container-max);
  }

  /* library-content (148:488): FIXED 493 из узла — от неё зависят переносы. */
  .library__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xl);
    width: 493px;
  }

  /* library-head (148:489): HUG 168 в спеке; коробка зафиксирована, потому что
     браузер добавляет трекинг eyebrow после последней буквы (+3.2 px). */
  .library__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
    width: 168px;
  }

  .library__eyebrow {
    color: var(--color-accent-muted);
  }

  /* meta (148:491): HUG по содержимому, пункты по центру, gap 8. */
  .library__meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
  }

  .library__meta-item {
    color: var(--color-text-secondary);
  }

  /* dot-l (148:493): 3×3 из узла. */
  .library__dot {
    flex: none;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-text-secondary);
  }

  /* library-body (148:497): ширина FILL от content — 493. */
  .library__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xl);
    width: 100%;
  }

  /* Заголовок и описание — FILL из спеки: без width: 100 % во flex-колонке
     они схлопнулись бы до max-content и переносы ушли бы. */
  .library__title {
    width: 100%;
    color: var(--color-text-heading);
  }

  .library__desc {
    width: 100%;
    color: var(--color-text-primary);
  }

  /* btn-quiet (148:500): plain/S — gap 8, CENTER/CENTER, 210×29. */
  .library__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-s);
    color: var(--color-accent);
  }

  .library__btn-label {
    white-space: nowrap;
  }

  /* arrow-quiet (I148:500;16:62): 19×19 из узла. */
  .library__arrow {
    display: block;
    flex: none;
    width: 19px;
    height: 19px;
  }

  .library__arrow :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
