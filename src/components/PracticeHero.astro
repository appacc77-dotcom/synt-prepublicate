---
/**
 * Секция `hero` страницы практики (409:243), 1440×900.
 *
 * Фон — FILL [[1, 0, 0], [0, 1, 0]]: cover, центр. Заголовок набран
 * Cormorant Garamond, а не Literata.
 *
 * В спеке инстанс шапки лежит ВНУТРИ кадра hero (`410:1381` на глубине 1),
 * поэтому шапка передаётся слотом, а не ставится рядом на странице.
 */
interface Props {
  node?: string;
}

const { node = '409:243' } = Astro.props;
---

<section class="prhero" data-figma-node={node}>
  <slot />
  <div class="prhero__info" data-figma-node="409:244">
    <h1 class="prhero__title" data-figma-node="409:245">
      Пространство практики<br />Syntonia
    </h1>
    <p class="prhero__desc" data-figma-node="409:246">
      Практики для самостоятельной внутренней работы, восстановления состояния и бережного движения в глубину.
    </p>
  </div>
</section>

<style>
  .prhero {
    position: relative;
    width: 100%;
    height: 900px;
    background-image: url('/img/practice-hero.webp');
    background-size: cover;
    background-position: 50% 50%;
    background-repeat: no-repeat;
  }

  .prhero__info {
    position: absolute;
    left: 64px;
    top: 492px;
    width: 830px;
    height: 312px;
  }

  .prhero__title {
    width: 830px;
    height: 170px;
    margin: 0;
    font-family: var(--font-cormorant-garamond);
    font-size: 85px;
    line-height: 85px;
    font-weight: 400;
    color: var(--color-text-on-image);
  }

  .prhero__desc {
    width: 520px;
    height: 102px;
    margin: 40px 0 0;
    font-size: 20px;
    line-height: 34px;
    color: var(--color-text-on-image);
  }
</style>
