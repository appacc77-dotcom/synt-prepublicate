---
/**
 * Секция `masters-more` (256:374), 1440×620: «Продолжить знакомство» и три
 * карточки-ссылки.
 *
 * Фон — линейный градиент из файла: стопы #c9bea4 (1,7 %) и #f4eee3 (100 %),
 * направление посчитано из `gradientTransform` [[-0.7411, 0.1396, …], …]:
 * вектор (−0.7411·1440, 0.1396·620) даёт 265,4°.
 *
 * Картинки карточек — `scaleMode: CROP` с матрицей [[0.5225, 0, 0.3111], …]:
 * размер 191,4 %, позиция по X 65,2 %.
 */
import ArrowQuiet from './ds/arrow-quiet.astro';

interface Props {
  node?: string;
}

const { node = '256:374' } = Astro.props;

const cards = [
  {
    title: 'Понять, с чего начать',
    text: 'Короткая диагностика поможет увидеть, какое состояние сейчас сильнее всего влияет на ваши реакции, выборы и внутренний маршрут.',
    label: 'Пройти диагностику',
    href: '/quiz.html',
    image: '/img/quiz-bg.jpg',
    // CROP [[0.5225, 0, 0.3111], [0, 1, 0]] → 191.4 % × 100 %, позиция 65.2 %.
    size: '191.4% 100%',
    position: '65.2% 0%',
    node: '257:470',
  },
  {
    title: 'Узнать о методе',
    text: 'Если вам важно понять, как работает Syntonia: почему разговор сам по себе не всегда меняет сценарий и что значит идти к источнику состояния.',
    label: 'Метод Syntonia',
    href: '/method.html',
    image: '/img/masters-more-2.jpg',
    // FILL: картинка вписывается по cover, трансформация её не сдвигает —
    // проверено перебором по кропу: лучшее совпадение при 50 % и cover.
    size: 'cover',
    position: '50% 50%',
    node: '257:482',
  },
  {
    title: 'Почитать глубже',
    text: 'Книга, журнал и тексты Syntonia — для медленного знакомства с подходом, словами и состояниями, к которым можно возвращаться.',
    label: 'Открыть библиотеку',
    href: '/library.html',
    image: '/img/masters-more-3.jpg',
    // CROP [[1, 0, −0.0011], [0, 0.3524, 0.1489]] → 100 % × 283.8 %, позиция 0 % 23 %.
    size: '100% 283.8%',
    position: '0% 23%',
    node: '257:517',
  },
];
---

<section class="more" data-figma-node={node}>
  <div class="more__container" data-figma-node="256:375">
    <div class="more__intro" data-figma-node="256:376">
      <h2 class="more__title" data-figma-node="256:380">Продолжить знакомство</h2>
      <div class="more__text" data-figma-node="256:383">
        <p class="more__para">Если вы пока не знаете, с чего начать, не обязательно сразу выбирать мастера.</p>
        <p class="more__para more__para--second">
          Можно сначала понять метод, пройти диагностику состояния или познакомиться с текстами Syntonia глубже.
        </p>
      </div>
    </div>

    {cards.map((card) => (
      <article class="more__card" data-figma-node={card.node}>
        <div
          class="more__card-image"
          style={`background-image: url('${card.image}'); background-size: ${card.size}; background-position: ${card.position}`}
        />
        <div class="more__card-body">
          <h3 class="more__card-title">{card.title}</h3>
          <p class="more__card-text">{card.text}</p>
          <a class="more__card-link" href={card.href}>
            <span>{card.label}</span>
            <ArrowQuiet size={14} />
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .more {
    position: relative;
    width: 100%;
    height: 620px;
    /* Направление — из gradientTransform (265,4°), стопы — из gradientStops как есть.
       Сжатие стопов под длину линии CSS проверено числом и оказалось хуже: 4,70
       против 2,63 по фону. */
    background: linear-gradient(265.4deg, #c9bea4 1.7%, #f4eee3 100%);
    /* padding, а не margin у контейнера: иначе отступ схлопывается и вся
       секция съезжает на 96 px вверх. */
    padding-top: 96px;
  }

  .more__container {
    display: flex;
    gap: 32px;
    width: 1280px;
    height: 428px;
    margin: 0 auto;
  }

  .more__intro {
    display: flex;
    flex-direction: column;
    width: 296px;
    height: 428px;
  }

  .more__title {
    width: 296px;
    height: 108px;
    margin: 0;
    font-family: var(--font-literata);
    font-size: 43px;
    line-height: 54px;
    font-weight: 400;
    /* Заголовок в файле привязан к text-primary (#433d34). */
    color: var(--color-text-primary);
  }

  .more__text {
    width: 296px;
    /* Высота из спеки: у текстового слоя задана фиксированная 272, а не hug. */
    height: 272px;
    margin: 48px 0 0;
    /* Вступление крупнее карточек: 17/23 из спеки, не 13/20. */
    font-size: 17px;
    line-height: 23px;
    /* В файле переменная text-deep (#6b6357), не text-primary. */
    color: var(--color-text-deep);
  }

  /* Между абзацами в файле пустая строка: зазор 17 px сверх обычного
     межстрочного, иначе вторая часть поднимается на строку выше. */
  .more__para {
    margin: 0;
  }

  .more__para--second {
    margin-top: 17px;
  }

  .more__card {
    display: flex;
    flex-direction: column;
    width: 296px;
    height: 428px;
    border-radius: 12px;
    background: var(--color-bg-page);
    overflow: hidden;
  }

  .more__card-image {
    width: 296px;
    height: 236px;
    background-repeat: no-repeat;
  }

  .more__card-body {
    display: flex;
    flex-direction: column;
    margin-top: 16px;
    padding: 0 16px;
    height: 160px;
  }

  .more__card-title {
    width: 264px;
    height: 28px;
    margin: 0;
    font-size: 22px;
    line-height: 28px;
    font-weight: 400;
    color: var(--color-text-deep);
  }

  .more__card-text {
    width: 264px;
    margin: 16px 0 0;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-text-secondary);
  }

  .more__card-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    height: 20px;
    color: var(--color-text-deep);
    text-decoration: none;
    font-size: 13px;
    line-height: 20px;
  }

  .more__card-link :global(svg) {
    display: block;
  }
</style>
