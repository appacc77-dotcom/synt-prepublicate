---
/**
 * Секция `founder-hero` (217:238), 1440×839: фото основателя, имя, роль, цитата,
 * кнопка, плеер и тёмная панель с аккордеоном из пяти пунктов.
 *
 * Тексты пунктов 2–5 в спеке не лежат: в файле у свёрнутых инстансов остался
 * текст первого. Они взяты из `states.json` — там пять состояний, по одному на
 * открытый пункт.
 *
 * Фото — FILL с матрицей [[0.5963, 0, 0.1966], [0, 1.0656, −0.0653]];
 * панель — CROP [[1, 0, −0.0005], [0, 0.8685, 0.0655]] → 100 % × 115,1 %,
 * позиция 0 % 49,8 %.
 */
import BtnPrimary from './ds/btn-primary.astro';
import ArrowQuiet from './ds/arrow-quiet.astro';
import wave from '../icons/wave.svg?raw';
import playBtn from '../icons/play-btn.svg?raw';

interface Props {
  node?: string;
}

const { node = '217:238' } = Astro.props;

const items = [
  {
    title: 'Видеть глубже',
    num: '01',
    text: 'Меня всегда интересовала глубина человеческой природы: как в одной личности переплетаются сила и уязвимость, осознанность и запутанность, желание жить и при этом разрушать себя.\nПочему человек может искренне хотеть перемен, стараться, искать, пробовать — и всё равно снова упираться в ту же невозможность что-то изменить.',
  },
  {
    title: 'Путь в профессию',
    num: '02',
    text: 'Я пришла в эту работу не просто из интереса.\nЯ всегда видела человека глубже его внешней истории, глубже слов и действий. Игнорировать это в себе не имело смысла, и я пошла учиться. Так я стала психологом. А позже, практикуя, я всё яснее понимала: именно то, что я вижу на уровне внутренних причин, часто и оказывается самым важным.',
  },
  {
    title: 'Суть моего взгляда',
    num: '03',
    text: 'Я знаю, как часто за сильным, собранным, разумным человеком живёт уставшая внутренняя часть, которая слишком долго несла то, что уже невозможно нести.\nИ как часто за внешне разными трудностями стоит одна и та же настоящая внутренняя причина. Моя работа никогда не была для меня просто профессией.\nЭто способ идти вместе с человеком туда, где становится ясно, что на самом деле с ним происходит, почему это повторяется и где начинается выход.',
  },
  {
    title: 'Ясность рядом',
    num: '04',
    text: 'Я не смотрю на человека как на набор проблем. Мне важно видеть в нём основание. Ту глубину, которая часто остаётся нетронутой под слоями напряжения, вины, страха, защиты или внутренней пустоты.\nИменно это люди чаще всего чувствуют рядом со мной: желанную ясность и точное внимание к тому, что в них действительно главное.',
  },
  {
    title: 'Пространство Syntonia',
    num: '05',
    text: 'Для меня это работа о возвращении человека к себе. К возможности жить не только из прошлого опыта, но и из чего-то более живого, свободного и настоящего.\nПоэтому я и создала Syntonia. Как пространство, в котором можно идти.\nТочно. Бережно. По-настоящему.',
  },
];
---

<section class="founder" data-figma-node={node}>
  <div class="founder__photo" data-figma-node="217:239">
    <div class="founder__content" data-figma-node="217:240">
      <div class="founder__text" data-figma-node="217:241">
        <h1 class="founder__name" data-figma-node="217:242">Екатерина Лебедева</h1>
        <p class="founder__role" data-figma-node="217:243">Психолог. Основатель Syntonia. Автор метода</p>
        <p class="founder__quote" data-figma-node="217:244">
          Я не работаю вокруг проблемы. Я веду к её источнику.
        </p>
      </div>

      <div class="founder__cta" data-figma-node="217:245">
        <BtnPrimary href="/#home-voices" label="Услышать голос" theme="light" size="L" compact />
      </div>

      <div class="founder__player" data-figma-node="233:296">
        <div class="founder__player-row">
          <button class="founder__play" type="button" aria-label="Слушать голос" data-play>
            <span class="founder__play-icon" set:html={playBtn} />
          </button>
          <span class="founder__wave" set:html={wave} />
          <span class="founder__time" data-figma-node="I233:296;217:250">1:25</span>
        </div>
        <p class="founder__note" role="status" aria-live="polite" data-note></p>
        {/* Обрезка в две строки — замысел, а не забытая высота. */}
        <p class="founder__teaser" data-figma-node="I233:296;217:251" data-overflow-ok>
          Можно многое понимать про себя и всё равно жить в одном и том же круге событий. Потому что вашей
          жизнью управляет не только то, что вы осознаёте.
        </p>
      </div>
    </div>
  </div>

  <div class="founder__aside" data-figma-node="217:252">
    <div class="founder__panel" data-figma-node="217:253">
      <div class="founder__accordion" data-figma-node="217:254">
        {items.map((item, i) => (
          <div class:list={['bio', i === 0 && 'is-open']} data-bio>
            <button class="bio__head" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span class="bio__label">
                <span class="bio__mark" aria-hidden="true" />
                <span class="bio__title">{item.title}</span>
              </span>
              <span class="bio__num">{item.num}</span>
            </button>
            <div class="bio__body">
              <p class="bio__text">{item.text}</p>
            </div>
            <span class="bio__divider" aria-hidden="true" />
          </div>
        ))}
      </div>

      <div class="founder__panel-cta" data-figma-node="217:260">
        <BtnPrimary href="/quiz.html" label="С чего начать" theme="light" size="L" caps compact padX={24} />
      </div>
    </div>
  </div>
</section>

<script>
  // Аудиозаписей в макете нет: кнопка не притворяется плеером.
  const play = document.querySelector('[data-play]');
  const playNote = document.querySelector('[data-note]');
  play?.addEventListener('click', () => {
    if (!playNote) return;
    playNote.textContent = 'Запись пока не приложена.';
    playNote.classList.add('is-visible');
  });

  for (const bio of document.querySelectorAll('[data-bio]')) {
    const head = bio.querySelector('.bio__head');
    head?.addEventListener('click', () => {
      const isOpen = bio.classList.contains('is-open');
      // Аккордеон в файле всегда с одним открытым пунктом.
      for (const other of document.querySelectorAll('[data-bio]')) {
        other.classList.remove('is-open');
        other.querySelector('.bio__head')?.setAttribute('aria-expanded', 'false');
      }
      if (!isOpen) {
        bio.classList.add('is-open');
        head.setAttribute('aria-expanded', 'true');
      }
    });
  }
</script>

<style>
  .founder {
    position: relative;
    display: flex;
    width: 100%;
    height: 839px;
    background: var(--color-bg-muted);
  }

  .founder__photo {
    position: relative;
    width: 876px;
    height: 839px;
    background-image: url('/img/founder-f27a7906.webp');
    /* FILL: cover. Горизонталь — из матрицы (48,7 %), вертикаль проверена
       числом: 50 % даёт 4,74, «низ» по формуле ty/(1−m11) — 14,41. Для FILL
       смещение в матрице не означает кадрирование, cover уже центрирует. */
    background-size: cover;
    /* Горизонталь из матрицы: 0,197/(1−0,596) = 48,8 %. */
    background-position: 48.8% 50%;
    background-repeat: no-repeat;
  }

  /* В файле поверх фото лежит чёрный слой с прозрачностью 12 %: без него
     фото выходит заметно светлее макета. */
  .founder__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 12%);
    pointer-events: none;
  }

  .founder__content {
    position: absolute;
    left: 0;
    top: 231px;
    width: 478px;
    height: 560px;
  }

  .founder__text {
    position: absolute;
    left: 48px;
    top: 0;
    width: 382px;
  }

  .founder__name {
    width: 382px;
    height: 128px;
    margin: 0;
    font-family: var(--font-literata);
    font-size: 64px;
    line-height: 64px;
    font-weight: 400;
    /* В файле имя привязано к text-on-image (#ffffff): тёмный текст на фото
       не читается. */
    color: var(--color-text-on-image);
  }

  .founder__role {
    width: 382px;
    margin: 32px 0 0;
    font-size: 24px;
    line-height: 32px;
    color: var(--color-text-on-image);
  }

  .founder__quote {
    width: 382px;
    margin: 32px 0 0;
    font-family: var(--font-lora);
    font-size: 24px;
    line-height: 34px;
    font-style: italic;
    color: var(--color-text-on-image);
  }

  .founder__cta {
    position: absolute;
    left: 48px;
    top: 356px;
  }

  .founder__player {
    position: absolute;
    left: 48px;
    top: 433px;
    width: 344px;
    height: 127px;
    border-radius: 12px;
    background: var(--color-bg-glass-dark);
    backdrop-filter: blur(10px);
  }

  .founder__player-row {
    position: relative;
    height: 47px;
    margin: 16px 16px 0;
  }

  .founder__play {
    position: absolute;
    left: 0;
    top: 0;
    width: 47px;
    height: 47px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .founder__play-icon :global(svg) {
    display: block;
  }

  .founder__wave {
    position: absolute;
    left: 55px;
    top: 9px;
    display: block;
    width: 222px;
    height: 29px;
    color: var(--color-text-on-image);
  }

  .founder__wave :global(svg) {
    display: block;
    width: 222px;
    height: 29px;
  }

  .founder__time {
    position: absolute;
    right: 0;
    top: 13px;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-text-on-image);
  }

  .founder__note {
    position: absolute;
    left: 16px;
    bottom: 2px;
    margin: 0;
    font-size: 11px;
    line-height: 14px;
    color: var(--color-text-on-image);
    opacity: 0;
    transition: opacity var(--motion-fast) var(--ease-out);
  }

  .founder__note.is-visible {
    opacity: 0.8;
  }

  .founder__teaser {
    /* В файле тизер обрезан двумя строками с многоточием (слой 312×40). */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    width: 312px;
    height: 40px;
    margin: 8px 16px 0;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-text-on-image);
  }

  .founder__aside {
    /* Фото держит свои 876, панель забирает остаток: при окне шире 1440
       иначе справа оставалась полоса фона секции (564 фиксированных). */
    flex: 1 1 auto;
    min-width: 564px;
    width: 564px;
    height: 839px;
    background: var(--color-bg-dark);
    /* BACKGROUND_BLUR 10 из спеки: геометрия его не видит, а без него панель
       выглядит плотной плитой вместо стекла. */
    backdrop-filter: blur(10px);
  }

  .founder__panel {
    position: relative;
    width: 516px;
    height: 687px;
    margin: 128px 0 0 24px;
    border-radius: 12px;
    background-image: url('/img/founder-dd1931fd.jpg');
    /* CROP [[1, 0, −0.0005], [0, 0.8685, 0.0655]] → 100 % × 115,1 %, позиция 0 % 49,8 %. */
    background-size: 100% 115.1%;
    background-position: 0% 49.8%;
    background-repeat: no-repeat;
    overflow: hidden;
  }

  .founder__accordion {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 452px;
    /* Высота из спеки: у фрейма аккордеона фиксированные 530, содержимое
       занимает 498 — остаток это нижний отступ, а не пустая строка. */
    height: 530px;
    margin: 32px 0 0 32px;
  }

  .bio {
    position: relative;
    width: 452px;
  }

  .bio__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 452px;
    height: 29px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    text-align: left;
  }

  .bio__label {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bio__mark {
    width: 3px;
    height: 24px;
    background: var(--color-accent-muted);
  }

  .bio__title {
    font-family: var(--font-literata);
    font-size: 25px;
    line-height: 29px;
    color: var(--color-text-on-image);
  }

  .bio__num {
    font-family: var(--font-great-vibes);
    font-size: 27px;
    line-height: 29px;
    color: var(--color-text-on-image);
  }

  /* В файле открытый пункт ничем не отличается от закрытых: и засечка, и
     заголовок, и номер одинаковые. Без признака состояния аккордеон читается
     как «ничего не произошло». Приглушаем закрытые — только существующие
     цвета, без новых. См. FIGMA-ISSUES. */
  .bio:not(.is-open) .bio__title,
  .bio:not(.is-open) .bio__num,
  .bio:not(.is-open) .bio__mark {
    opacity: 0.55;
  }

  .bio__title,
  .bio__num,
  .bio__mark {
    transition: opacity var(--motion-fast) var(--ease-out);
  }

  .bio__body {
    width: 452px;
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--motion-base) var(--ease-out);
  }

  .bio.is-open .bio__body {
    max-height: 156px;
  }

  .bio__text {
    width: 452px;
    margin: 16px 0 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-text-on-image);
    white-space: pre-line;
  }

  .bio__divider {
    display: block;
    width: 452px;
    height: 1px;
    margin-top: 16px;
    background: var(--color-border);
  }

  .founder__panel-cta {
    position: absolute;
    left: 32px;
    top: 610px;
  }
</style>
