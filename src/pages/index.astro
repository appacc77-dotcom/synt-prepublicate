---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Pain from '../components/Pain.astro';
import Banner from '../components/Banner.astro';
import Header from '../components/Header.astro';
import Formats from '../components/Formats.astro';
import Entry from '../components/Entry.astro';
import Method from '../components/Method.astro';
import Quiz from '../components/Quiz.astro';
import AboutFounder from '../components/AboutFounder.astro';
import Process from '../components/Process.astro';
import Voices from '../components/Voices.astro';
import AirPhoto from '../components/AirPhoto.astro';
import Library from '../components/Library.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';

const painItems = [
  {
    number: '01',
    text: 'Если жизнь идёт, а всё будто стоит на месте',
    nodes: {
      item: '79:123',
      row: 'I79:123;42:70',
      number: 'I79:123;42:71',
      text: 'I79:123;42:72',
      divider: 'I79:123;42:74',
    },
  },
  {
    number: '02',
    text: 'Если попыток было уже столько, а по-настоящему легче так и не стало',
    nodes: {
      item: '79:124',
      row: 'I79:124;42:70',
      number: 'I79:124;42:71',
      text: 'I79:124;42:72',
      divider: 'I79:124;42:74',
    },
  },
  {
    number: '03',
    text: 'Если ты устаёшь носить в себе напряжение, тяжесть или скрытую боль',
    nodes: {
      item: '79:125',
      row: 'I79:125;42:70',
      number: 'I79:125;42:71',
      text: 'I79:125;42:72',
      divider: 'I79:125;42:74',
    },
  },
  {
    number: '04',
    text: 'Если тебе нужна глубокая и точная внутренняя работа',
    nodes: {
      item: '79:126',
      row: 'I79:126;42:70',
      number: 'I79:126;42:71',
      text: 'I79:126;42:72',
      divider: 'I79:126;42:74',
    },
  },
];
const faqAnswer =
  'Да и поможет. Работа идёт глубже — с внутренним состоянием, подсознательными причинами и тем, что на тонком плане управляет жизнью.';

const faqItems = [
  {
    state: 'open',
    question: 'Если я уже был в терапии, мне это подойдёт?',
      answer: 'Да и поможет. Работа идёт глубже — с внутренним состоянием, подсознательными причинами и тем, что на тонком плане управляет жизнью.',
    answer: faqAnswer,
    nodes: {
      item: '148:519',
      head: 'I148:519;141:320',
      question: 'I148:519;140:349',
      icon: 'I148:519;756:1883',
      answer: 'I148:519;140:350',
    },
  },
  {
    state: 'closed',
    question: 'Чем этот подход отличается от обычной психологии?',
      answer: 'Здесь важно не только понять сознательную причину, но и изменить внутреннюю реальность, из которой рождаются чувства, реакции и события.',
    nodes: {
      item: '148:520',
      head: 'I148:520;144:357',
      question: 'I148:520;144:358',
      icon: 'I148:520;755:2882',
    },
  },
  {
    state: 'closed',
    question: 'Зачем мне это, если я уже многое о себе понял?',
      answer: 'Потому что понимание не всегда меняет жизнь. Важно не только увидеть, но и сдвинуть саму внутреннюю точку, из которой всё строится.',
    nodes: {
      item: '148:521',
      head: 'I148:521;144:357',
      question: 'I148:521;144:358',
      icon: 'I148:521;755:2882',
    },
  },
  {
    state: 'closed',
    question: 'Чем Точка входа отличается от мастер-сессии?',
      answer: 'Точка входа помогает увидеть главное и понять следующий шаг. Мастер-сессия — это уже более глубокая работа с запросом.',
    nodes: {
      item: '148:522',
      head: 'I148:522;144:357',
      question: 'I148:522;144:358',
      icon: 'I148:522;755:2882',
    },
  },
  {
    state: 'closed',
    question: 'Сколько встреч обычно нужно?',
      answer: 'Это зависит от глубины запроса и цели. Иногда многое становится ясно уже после первой встречи. Если жизненный сценарий повторяется давно, работа может потребовать большего пути.',
    nodes: {
      item: '148:523',
      head: 'I148:523;144:357',
      question: 'I148:523;144:358',
      icon: 'I148:523;755:2882',
    },
  },
