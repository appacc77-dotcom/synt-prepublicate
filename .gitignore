node_modules/
dist/
.astro/
.DS_Store
.screens/
.state/
.npmcache/
.npmlogs/

# Источник — живой файл Figma, а не выгрузка. .fig в проект не кладём.
*.fig

# Снимки моста и кропы коммитятся: они малы и привязаны к fileKey.
# Тяжёлые выгрузки, если появятся, — только локально:
#   design/export/**

# Мусор от ошибочных путей
tmp/
var/

.build.lock
.coldstart/

# токен Figma — только локально
.figma-token

# прогоны проверок — доказательства на диске, не в репозитории
reports/runs/


# временные скрипты для моста
.tmp/

# отчёты проверяющего — артефакты прогона, не исходники
reviews/

# Счётчик моста: его переписывает каждый вызов плагина. Пока файл в git,
# дерево всегда «грязное», и push-ok честно отказывает в пуше.
design/figma-contention.json

# base-сборка «только из макета» — артефакт проверки
dist-base/

# Local Netlify folder
.netlify

# Выпуск: генерируется site-export, в git не живёт
.site/
.site-branch/
site-manifest.json

# Картинки черновика генератора: копируются по хешу и не публикуются
public/img/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].*

# Зеркало: временный git-репозиторий выпуска
.site-mirror/
