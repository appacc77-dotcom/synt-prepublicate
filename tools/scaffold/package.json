{
  "name": "syntonia",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Syntonia: Figma → спецификация → компоненты → страницы. Проект перезапущен 06.11.2026 по процессу docs/system/PROCESS.md.",
  "scripts": {
    "setup": "npm ci",
    "setup:browsers": "npx playwright install chromium",
    "intake": "node tools/intake.mjs",
    "document": "node tools/document.mjs",
    "api": "node tools/figma-api.mjs",
    "stamp": "node tools/stamp.mjs",
    "discover": "node tools/discover.mjs",
    "export": "node tools/export-section.mjs",
    "export:all": "node tools/export-all.mjs",
    "assets:prune": "node tools/assets-prune.mjs",
    "fig": "node tools/fig-file.mjs",
    "verify": "node tools/conveyor.mjs check --profile accept-stage1 --cache",
    "page": "node tools/page-compare.mjs",
    "structure": "node tools/structure.mjs",
    "ds:tokens": "node tools/ds-tokens.mjs",
    "tone:fit": "node tools/fit-tone.mjs",
    "bake": "node tools/bake-image.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "prebuild": "node tools/prebuild.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4322",
    "shot": "node tools/shot.mjs",
    "measure": "node tools/measure.mjs",
    "compare": "node tools/compare.mjs",
    "assets:check": "node tools/check-assets.mjs",
    "status": "node tools/status.mjs",
    "scaffold": "node tools/scaffold.mjs",
    "portability": "node tools/check-portability.mjs",
    "variants": "node tools/variants.mjs",
    "bindings": "node tools/check-bindings.mjs",
    "interactive": "node tools/check-interactive.mjs",
    "tokens:check": "node tools/check-tokens.mjs",
    "motion": "node tools/check-motion.mjs",
    "scaffold:check": "node tools/check-scaffold.mjs",
    "layout": "node tools/check-layout.mjs",
    "invented": "node tools/check-invented.mjs",
    "registry": "node tools/check-registry.mjs",
    "conveyor": "node tools/conveyor.mjs",
    "hooks": "git config core.hooksPath tools/git-hooks && echo \"хуки включены: tools/git-hooks\"",
    "states": "node tools/check-states.mjs",
    "motion:manifest": "node tools/check-motion-manifest.mjs --write",
    "motion:check": "node tools/check-motion-manifest.mjs",
    "images": "node tools/check-images.mjs",
    "fonts": "node tools/fonts.mjs",
    "fonts:check": "node tools/fonts.mjs --check",
    "build:figma-only": "FIGMA_ONLY=1 ASTRO_OUT_DIR=dist-base ASTRO_TELEMETRY_DISABLED=1 astro build",
    "snapshot:diff": "node tools/snapshot-diff.mjs",
    "changes": "node tools/check-changes.mjs",
    "review": "node tools/review.mjs",
    "tokens:dtcg": "node tools/check-tokens-dtcg.mjs",
    "build:base": "FIGMA_ONLY=1 ASTRO_OUT_DIR=dist-base ASTRO_TELEMETRY_DISABLED=1 astro build",
    "fig:kiwi": "node tools/fig-kiwi.mjs",
    "spec:bounds": "node tools/check-spec-bounds.mjs",
    "spec:contract": "node tools/check-spec-contract.mjs",
    "fig:crosscheck": "node tools/fig-kiwi.mjs crosscheck",
    "report:designer": "node tools/report-designer.mjs",
    "report:studio": "node tools/report-studio.mjs",
    "gen": "node tools/gen.mjs",
    "gen:report": "node tools/gen.mjs report --all",
    "profile": "node tools/profile.mjs",
    "publish:check": "node tools/check-publish.mjs",
    "lib:check": "node tools/check-lib.mjs",
    "site:export": "node tools/site-export.mjs",
    "site:check": "node tools/conveyor.mjs check --profile release",
    "site:release": "node tools/site-export.mjs --push",
    "site:preview": "npx --yes serve .site/dist -l 4322",
    "weight": "node tools/check-weight.mjs",
    "map": "node tools/page-map.mjs --write",
    "links": "node tools/check-links.mjs",
    "crops": "node tools/check-crops.mjs",
    "issues": "node tools/issues.mjs",
    "issues:write": "node tools/issues.mjs --write"
  },
  "devDependencies": {
    "astro": "^7.4.5",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=20"
  }
}
