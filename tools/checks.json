{
  "version": 1,
  "note": "Контракт проверки: что она проверяет, к какому слою относится, какие входы читает, от чего зависит и в каких профилях обязательна. Конвейер строит граф по этим записям; сами инструменты остаются самостоятельными и про этот файл не знают.",
  "layers": {
    "base": "воспроизведение исходника: компоненты, тексты, состояния и свойства из файла Figma",
    "enhancements": "дополнения студии: адаптив, движение, поведение, интеграции",
    "integration": "совместимость слоёв: дополнения не ломают защищённые свойства основы",
    "common": "общая корректность: сборка, реестры, переносимость"
  },
  "profiles": {
    "local": "изменённая единица и её зависимости, без живого моста",
    "regression": "контрольный набор секций и зависимости",
    "accept-stage1": "полная приёмка основы по обязательствам слоя 1",
    "accept-stage2": "дополнения слоя 2 и их совместимость с основой",
    "sources-live": "сверка выгрузки с текущим состоянием Figma",
    "release": "выпуск: набор файлов сайта, манифест и связь с зелёным прогоном"
  },
